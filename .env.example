AMEM_EMBEDDING_MODEL=
AMEM_EMBEDDING_MODEL_REVISION=pinned-revision
AMEM_EMBEDDING_DIMENSIONS=1024
AMEM_EMBEDDING_BASE_URL=https://api.openai.com/v1
AMEM_EMBEDDING_API_KEY_ENV=EMBEDDING_API_KEY
EMBEDDING_API_KEY=
AMEM_EMBEDDING_TIMEOUT_SECONDS=30
AMEM_EMBEDDING_MIN_SIMILARITY=
AMEM_EMBEDDING_NORMALIZED=true
AMEM_EMBEDDING_SEND_DIMENSIONS=false
AMEM_EMBEDDING_QUERY_PREFIX=
AMEM_EMBEDDING_DOCUMENT_PREFIX=
