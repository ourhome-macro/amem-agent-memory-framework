FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src ./src
COPY recommend-radio/backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -e '.[dev]' -r /tmp/requirements.txt
COPY recommend-radio/backend ./recommend-radio/backend
COPY recommend-radio/scripts ./recommend-radio/scripts
COPY recommend-radio/evals ./recommend-radio/evals
CMD ["python", "-m", "pytest", "recommend-radio/backend/tests", "-q", "-p", "no:cacheprovider"]
